        "valid_quantities": {
          "name": "valid_quantities",
          "value": "\"preorders\".\"chocolate\" BETWEEN 0 AND 99 AND \"preorders\".\"lemon\" BETWEEN 0 AND 99 AND \"preorders\".\"mango\" BETWEEN 0 AND 99 AND \"preorders\".\"raspberry\" BETWEEN 0 AND 99"
        },
        "has_slices": {
          "name": "has_slices",
          "value": "\"preorders\".\"chocolate\" + \"preorders\".\"lemon\" + \"preorders\".\"mango\" + \"preorders\".\"raspberry\" > 0"
        },
        "valid_pickup_window": {
          "name": "valid_pickup_window",
          "value": "\"preorders\".\"pickup_window\" IN ('09-11', '11-13', '13-15', '15-17')"
        },
        "valid_price_feedback": {
          "name": "valid_price_feedback",
          "value": "\"preorders\".\"price_feedback\" IS NULL OR \"preorders\".\"price_feedback\" IN ('Good value', 'Reasonable', 'Too expensive')"
